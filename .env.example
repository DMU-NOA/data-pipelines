# 서울 열린데이터광장 (https://data.seoul.go.kr) 인증키
# - 실시간 도시데이터, S-DoT, 지하철/버스 승하차, 역/정류장 위치
# - 'sample' 키는 최대 5건까지만 조회되므로 테스트용으로만 사용
SEOUL_API_KEY=

# 공공데이터포털 (https://www.data.go.kr) 일반 인증키 (Decoding)
# 아래 서비스를 각각 활용신청해야 한다.
# - 한국관광공사_국문 관광정보 서비스 (TourAPI)
# - 한국관광공사_영문/일문/중문간체/중문번체 관광정보 서비스 (선택)
# - 한국관광공사_관광지 집중률 방문자 추이 예측 정보
# - 기상청_지상(종관, ASOS) 시간자료 조회서비스
# - 한국천문연구원_특일 정보
DATA_GO_KR_API_KEY=

# PostgreSQL + PostGIS
DB_HOST=localhost
DB_PORT=5432
DB_NAME=noa
DB_USER=noa
DB_PASSWORD=
